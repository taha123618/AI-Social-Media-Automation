model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  permissions String[]
  isActive    Boolean   @default(true)
  lastUsed    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Webhook {
  id            String    @id @default(cuid())
  name          String
  url           String
  events        String[]
  isActive      Boolean   @default(true)
  secret        String?
  lastTriggered DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}
