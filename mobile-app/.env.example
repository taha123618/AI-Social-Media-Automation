# ==============================================================================
# SocialAI Mobile Companion App - Environment Variables
# ==============================================================================

# Application Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Backend Next.js API Server Base URL
# - iOS Simulator:        http://localhost:3000
# - Android Emulator:     http://10.0.2.2:3000
# - Physical Device (LAN): http://<YOUR_LOCAL_IP>:3000 (e.g. http://192.168.1.50:3000)
# - Production:           https://app.socialai.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Real-Time WebSocket Endpoint
EXPO_PUBLIC_WS_URL=ws://localhost:3000/ws

# Enable offline fallback mock dataset when backend is unreachable during dev
EXPO_PUBLIC_ENABLE_OFFLINE_MOCK=false


# where on the mobile-app/* I want the exact work just like it do on the app/* , components/*, contexts/*, features/* and others 

